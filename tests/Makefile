	./adv_1d_multi_rhs -n 1000 -nrhs 5 -rebuild_solve -ksp_reuse_preconditioner
#
	@echo "Test multiple RHS block solve with a Richardson KSP and PCPFLAREINV with a fixed iteration count"
	./adv_1d_multi_rhs -n 1000 -nrhs 5 -ksp_type richardson -ksp_norm_type none -ksp_max_it 30
	@echo "Test multiple RHS block solve with a Richardson KSP and PCAIR with a fixed iteration count"
	./adv_1d_multi_rhs -n 1000 -nrhs 5 -pc_type air -ksp_type richardson -ksp_norm_type none -ksp_max_it 10
	@echo "Test multiple RHS block solve with Richardson KSP and PCAIR"
	$(SKIP_SINGLE) ./adv_1d_multi_rhs -n 1000 -nrhs 5 -pc_type air -ksp_type richardson -ksp_rtol 1e-10 \
	 -check_tol 1e-8
	@echo "Test the block apply of the matrix-free Arnoldi matshell directly, plain and diagonally scaled"
	./shell_block_apply -n 1000 -nrhs 5 -inverse_type 1
	@echo "Test the block apply of the matrix-free Newton matshell directly, plain and diagonally scaled"
	./shell_block_apply -n 1000 -nrhs 5 -inverse_type 2
	@echo "Test the block apply of the matrix-free Neumann matshell directly"
	./shell_block_apply -n 1000 -nrhs 5 -inverse_type 4
#
	@echo ""
	@echo "Test 3D upwind finite-difference"
	./adv_diff_fd -dim 3 -da_grid_x 10 -da_grid_y 10 -da_grid_z 10 -pc_type air -ksp_pc_side right \
	 -ksp_rtol $(KSP_RTOL) -ksp_atol 1e-50 -pc_air_a_lump -ksp_max_it 4
#
	@echo ""
	@echo "Test high order GMRES polynomials in small linear system"
	./adv_diff_fd -da_grid_x 5 -da_grid_y 5 -pc_type pflareinv -pc_pflareinv_type newton \
	 -pc_pflareinv_matrix_free -pc_pflareinv_poly_order 16 -ksp_max_it 1
	@echo "Test high order GMRES polynomials in small linear system - slightly bigger"
	./adv_diff_fd -da_grid_x 10 -da_grid_y 10 -pc_type pflareinv -pc_pflareinv_type newton \
	 -pc_pflareinv_matrix_free -pc_pflareinv_poly_order 50 -ksp_max_it 1
# 
	@echo ""
	@echo "Test auto truncation with matrix-free Newton polynomials as coarse grid solver" 
	./adv_diff_fd -da_grid_x 10 -da_grid_y 10 -ksp_type richardson -pc_type air \
	 -pc_air_coarsest_inverse_type newton -pc_air_coarsest_poly_order 10 -pc_air_coarsest_matrix_free_polys \
	 -pc_air_auto_truncate_start_level 1 -pc_air_auto_truncate_tol 1e-2 -ksp_max_it 3 \
	 -pc_air_a_drop 1e-3 -pc_air_inverse_type power
#
	@echo ""
	@echo "Test improving Z with PC regenerated with no sparsity change"
	./ex6f -m 10 -n 10 -regen -pc_air_reuse_sparsity -pc_air_improve_z_its 3 -ksp_max_it 3 -pc_air_a_drop 1e-3 -pc_air_inverse_type power
	@echo "Test improving Z with PC regenerated with no sparsity change with 1 iteration"
	./ex6f -m 10 -n 10 -regen -pc_air_reuse_sparsity -pc_air_improve_z_its 1 -ksp_max_it 3 -pc_air_a_drop 1e-3 -pc_air_inverse_type power			
#
	@echo ""
